# Pooled Neon connection. Do not commit the real file.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct connection, used by some ORMs. This project uses the pooled URL above.
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# https://supermemory.ai — leave empty to skip remote memory. Nothing is written to MEMORY.md.
SUPERMEMORY_API_KEY=
